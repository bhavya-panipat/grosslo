# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real keys.

# Optional. Without this, AI-backed extraction/explanation/compliance-
# phrasing endpoints fall back to deterministic logic (see /health).
ANTHROPIC_API_KEY=

# Optional. Without these, /api/razorpayx/balance returns 503 — every
# other route in this app still works, since nothing else makes a live
# RazorpayX call (see razorpayx_client.py's own docstring).
#
# Generate a TEST-MODE key pair from the RazorpayX Dashboard: turn on the
# "Test Mode" toggle, then Account & Settings -> API Keys -> Generate Key.
# RAZORPAYX_KEY_ID must start with "rzp_test_" — a live-mode key
# ("rzp_live_...") is refused by this app on purpose, with no override.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=

# Optional. Signs the HR/Finance session cookie (see auth.py). Without
# this, the app auto-generates an ephemeral one at process start — it
# still works, but sessions won't survive a server restart. Set this to
# persist sessions across restarts. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# REMOVED in Phase 1.1 step 5. HR_ACCESS_CODE / FINANCE_ACCESS_CODE were one
# HR code and one Finance code for the whole process — with two tenants, the
# same shared secret would open both companies' review queues. Access codes are
# now per tenant, stored as hashes in tenant_settings, and set when the tenant
# is provisioned:
#   python3 scripts/create_tenant.py --slug acme --name "Acme Corp" \
#       --hr-code ... --finance-code ...
# Setting these variables now has no effect on anything.

# Optional. Host suffix under which a leading label identifies a tenant, i.e.
# {slug}.grosslo.app. Change it if you deploy on another domain.
TENANT_DOMAIN_SUFFIX=

# Optional. Postgres connection string for review_queue.py's persistence
# (submissions / submission_rows). Without it the default is
# postgresql:///grosslo?user=grosslo_app — the local Homebrew postgresql@16
# cluster over the unix socket, as the unprivileged grosslo_app role created
# by scripts/setup_app_role.sql.
#
# If you point this at a different role, it MUST NOT be a superuser and MUST
# NOT have BYPASSRLS: both are exempt from every row-level-security policy, so
# the tenant-isolation layer would silently enforce nothing.
#
# A REACHABLE POSTGRES IS NOW REQUIRED TO RUN THE TEST SUITE, not just the
# app: app.py calls review_queue.init_db() at import time, so a stopped
# server fails the tests at *collection* with a wall of connection errors.
# That is a missing service, not a bug in the code under test. Start it with:
#   brew services start postgresql@16
DATABASE_URL=
